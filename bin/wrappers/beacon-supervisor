#!/usr/bin/env bash
# /opt/beacon/bin/beacon-supervisor — root:root 0755
set -euo pipefail

SUPERVISORCTL=/usr/bin/supervisorctl
CONF_DIR="${BEACON_SUPERVISOR_CONF_DIR:-/etc/supervisor/conf.d}"

die() { printf 'beacon-supervisor: %s\n' "$*" >&2; exit 64; }

valid_program() {
    local prog="${1:-}"
    [[ "$prog" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || die "invalid program name"
    [[ ! "$prog" =~ ^beacon-panel ]]             || die "reserved program name"
}

action="${1:-}"; shift || true

case "$action" in
    write)
        prog="${1:-}"; valid_program "$prog"
        tmp="$(mktemp "$CONF_DIR/.beacon-XXXXXX")"
        trap 'rm -f "$tmp"' EXIT
        cat > "$tmp"

        grep -Eqi '^[[:space:]]*user[[:space:]]*=[[:space:]]*root' "$tmp" \
            && die "supervisor unit may not run as root"
        grep -Eq '^[[:space:]]*user[[:space:]]*=[[:space:]]*beacon[[:space:]]*$' "$tmp" \
            || die "supervisor unit must declare user = beacon"
        grep -Eq '^[[:space:]]*command[[:space:]]*=[[:space:]]*(/home/beacon/|/usr/bin/|/usr/local/)' "$tmp" \
            || die "command must live under /home/beacon, /usr/bin or /usr/local"

        chmod 0644 "$tmp"
        mv -f "$tmp" "$CONF_DIR/${prog}.conf"; trap - EXIT
        "$SUPERVISORCTL" reread >/dev/null && "$SUPERVISORCTL" update
        ;;
    delete)
        prog="${1:-}"; valid_program "$prog"
        rm -f "$CONF_DIR/${prog}.conf"
        "$SUPERVISORCTL" reread >/dev/null && "$SUPERVISORCTL" update
        ;;
    reread-update)
        "$SUPERVISORCTL" reread && "$SUPERVISORCTL" update
        ;;
    start|stop|restart)
        prog="${1:-}"; valid_program "$prog"
        # Target the process GROUP, not a bare name.
        #
        # A program declaring
        #     process_name = %(program_name)s_%(process_num)02d
        # registers its worker as `name_00` inside a group called `name`, so
        # `supervisorctl restart name` matches nothing and reports
        #     name: ERROR (no such process)
        # `name:*` addresses every process in the group and works equally for
        # single-process programs, which get a one-member group of the same
        # name.
        "$SUPERVISORCTL" "$action" "${prog}:*"
        ;;
    status)
        if [[ $# -gt 0 ]]; then
            prog="${1:-}"; valid_program "$prog"
            # status exits non-zero when a process is not RUNNING; the caller
            # parses stdout, so that is expected rather than an error.
            "$SUPERVISORCTL" status "${prog}:*" || true
        else
            "$SUPERVISORCTL" status || true
        fi
        ;;
    *)
        die "unknown action: ${action:-<none>}"
        ;;
esac
