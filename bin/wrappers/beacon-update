#!/usr/bin/env bash
# /opt/beacon/bin/beacon-update — root:root 0755
# Panel self-update: build unprivileged, promote as root, health-gate, auto-rollback.
# Exit codes: 0 ok | 64 bad usage | 66 not found | 70 health check failed
set -euo pipefail

ROOT="${BEACON_PANEL_ROOT:-/opt/beacon/panel}"
SHARED="${BEACON_PANEL_SHARED:-${ROOT}/shared}"
REPO="${BEACON_PANEL_REPO:-https://github.com/torgodly/beacon.git}"
KEEP="${BEACON_PANEL_KEEP_RELEASES:-3}"
PANEL_USER="${BEACON_PANEL_USER:-beacon-panel}"
PHP_VERSION="${BEACON_PANEL_PHP_VERSION:-8.4}"
PHP_FPM="php${PHP_VERSION}-fpm"
BEACON_BIN="${BEACON_PANEL_BIN:-/opt/beacon/bin}"
HEALTH_URL="${BEACON_PANEL_HEALTH_URL:-http://127.0.0.1/up}"
SUPERVISORCTL="${SUPERVISORCTL:-/usr/bin/supervisorctl}"
SYSTEMCTL="${SYSTEMCTL:-/usr/bin/systemctl}"
CURL="${CURL:-/usr/bin/curl}"

die() { printf 'beacon-update: %s\n' "$*" >&2; exit 64; }

restart_runtime() {
    if "$SYSTEMCTL" is-active --quiet "$PHP_FPM" 2>/dev/null; then
        "$SYSTEMCTL" restart "$PHP_FPM"
    fi

    if "$SUPERVISORCTL" status beacon-panel-worker >/dev/null 2>&1; then
        "$SUPERVISORCTL" restart beacon-panel-worker
    fi
}

sync_nginx_configs() {
    local deploy_dir="${ROOT}/current/deploy/nginx"
    local nginx_test="${NGINX:-/usr/sbin/nginx}"

    [[ -f "${deploy_dir}/beacon-global.conf" ]] || return 0

    install -m 0644 "${deploy_dir}/beacon-global.conf" /etc/nginx/conf.d/beacon-global.conf

    if "$nginx_test" -t >/dev/null 2>&1; then
        "$SYSTEMCTL" reload nginx
    else
        printf 'beacon-update: WARN: nginx config test failed after syncing beacon-global.conf\n' >&2
    fi
}

sync_sandbox_dropins() {
    local sandbox_src="${ROOT}/current/bin/lib/beacon-sandbox-paths.sh"

    [[ -f "$sandbox_src" ]] || return 0

    # shellcheck source=/dev/null
    source "$sandbox_src"
    beacon_sync_sandbox_dropins "$PHP_VERSION"
}

sync_wrappers() {
    local wrapper_src="${ROOT}/current/bin/wrappers"
    local wrapper

    [[ -d "$wrapper_src" ]] || return 0

    install -d -m 0755 "$BEACON_BIN"
    for wrapper in nginx php supervisor certbot service pkg cron update run fs; do
        [[ -f "${wrapper_src}/beacon-${wrapper}" ]] || continue
        install -m 0755 "${wrapper_src}/beacon-${wrapper}" "${BEACON_BIN}/beacon-${wrapper}"
    done
}

promote_release() {
    local target="$1"
    ln -sfn "$target" "${ROOT}/current.new"
    mv -Tf "${ROOT}/current.new" "${ROOT}/current"
}

prune_releases() {
    local count=0
    local dir

    while IFS= read -r dir; do
        count=$((count + 1))
        if (( count > KEEP )); then
            rm -rf "$dir"
        fi
    done < <(ls -1dt "${ROOT}"/releases/*/ 2>/dev/null || true)
}

# Run a command as the panel user, from a directory it can actually enter.
#
# runuser keeps the caller's working directory. This wrapper is invoked over
# sudo from the panel, so the inherited cwd is whatever the panel process had
# — frequently unreadable to beacon-panel. Composer calls getcwd()/chdir() on
# startup and dies with "chdir(): Permission denied (errno 13)".
# runuser also *preserves* the caller's environment, so HOME stays whatever
# the panel had. npm would write its cache to an unreadable directory and
# Composer likewise. Pin HOME and the cache locations explicitly.
panel_run() {
    local workdir="$1"
    shift
    ( cd "$workdir" && runuser -u "$PANEL_USER" -- env \
        HOME="/home/${PANEL_USER}" \
        USER="$PANEL_USER" \
        COMPOSER_HOME="/home/${PANEL_USER}/.composer" \
        COMPOSER_ALLOW_SUPERUSER=0 \
        NPM_CONFIG_CACHE="/home/${PANEL_USER}/.npm" \
        NPM_CONFIG_UPDATE_NOTIFIER=false \
        CI=true \
        PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        "$@" )
}

action="${1:-deploy}"; shift || true

case "$action" in
    deploy)
        ref="${1:-}"
        [[ "$ref" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "bad tag: ${ref:-<none>}"

        rel="${ROOT}/releases/$(date -u +%Y%m%d%H%M%S)"
        prev=""
        if [[ -L "${ROOT}/current" ]]; then
            prev="$(readlink -f "${ROOT}/current" || true)"
        fi

        install -d -o "$PANEL_USER" -g "$PANEL_USER" -m 0755 "$rel"
        panel_run "$rel" git clone --depth 1 --branch "$ref" "$REPO" "$rel"
        panel_run "$rel" git -C "$rel" verify-tag "$ref" 2>/dev/null \
            || printf 'beacon-update: WARN: unsigned tag %s\n' "$ref" >&2
        # Wire shared state before composer: its post-autoload-dump hook runs
        # `artisan package:discover`, which boots Laravel and needs a writable
        # bootstrap/cache and a readable .env. Linking afterwards also means
        # composer writes a package manifest into a directory that is then
        # deleted and replaced.
        rm -rf "$rel/storage" "$rel/bootstrap/cache"
        install -d -o "$PANEL_USER" -g "$PANEL_USER" -m 0755 "${rel}/bootstrap"
        ln -sfn "${SHARED}/.env" "${rel}/.env"
        ln -sfn "${SHARED}/storage" "${rel}/storage"
        ln -sfn "${SHARED}/bootstrap-cache" "${rel}/bootstrap/cache"

        panel_run "$rel" composer install -d "$rel" --no-dev --no-interaction \
            --prefer-dist --optimize-autoloader

        # bootstrap/cache is shared between releases, so this release starts
        # with the previous one's route and config cache. wayfinder:generate
        # runs during the Vite build and would enumerate those stale routes,
        # omitting typed helpers for anything added in this release.
        #
        # Removed directly rather than via `artisan optimize:clear`: that runs
        # cache:clear (Redis) before route:clear, so an unreachable Redis
        # aborts it before the route cache is ever touched.
        rm -f "$rel/bootstrap/cache/config.php" \
              "$rel/bootstrap/cache/events.php" \
              "$rel"/bootstrap/cache/routes-v*.php

        panel_run "$rel" npm --prefix "$rel" ci
        panel_run "$rel" npm --prefix "$rel" run build

        panel_run "$rel" php "$rel/artisan" migrate --force
        panel_run "$rel" php "$rel/artisan" optimize

        # Root-owned so a panel compromise cannot rewrite its own source, but
        # readable by all: php-fpm runs as beacon-panel and nginx serves
        # public/ as www-data, and neither owns the tree. Without a+rX a
        # restrictive umask during the clone leaves both locked out and the
        # panel answers "File not found." Secrets live in shared/.env (0640).
        chown -R root:"$PANEL_USER" "$rel"
        chmod -R a+rX,go-w "$rel"

        promote_release "$rel"
        sync_wrappers
        sync_nginx_configs
        sync_sandbox_dropins
        restart_runtime

        ok=0
        for _ in $(seq 1 15); do
            sleep 1
            if "$CURL" -fsS --max-time 3 "$HEALTH_URL" >/dev/null 2>&1; then
                ok=1
                break
            fi
        done

        if [[ "$ok" != 1 && -n "$prev" ]]; then
            printf 'beacon-update: health check failed — rolling back to %s\n' "$prev" >&2
            promote_release "$prev"
            restart_runtime
            rm -rf "$rel"
            exit 70
        fi

        if [[ "$ok" != 1 ]]; then
            die "health check failed and no previous release to roll back to"
        fi

        prune_releases
        ;;

    rollback)
        target=""
        count=0

        while IFS= read -r dir; do
            count=$((count + 1))
            if (( count == 2 )); then
                target="${dir%/}"
                break
            fi
        done < <(ls -1dt "${ROOT}"/releases/*/ 2>/dev/null || true)

        if [[ -z "$target" ]]; then
            printf 'beacon-update: no previous release to roll back to\n' >&2
            exit 66
        fi

        promote_release "$target"
        sync_wrappers
        sync_nginx_configs
        sync_sandbox_dropins
        restart_runtime
        ;;

    *)
        die "unknown action: ${action:-<none>}"
        ;;
esac
